[Unit]
Description=STM32 Data Reader (raccoon_ring backend)
Requires=lcm-loopback-multicast.service
After=lcm-loopback-multicast.service

[Service]
User=pi
Group=pi

WorkingDirectory=/home/pi/stm32_data_reader

# raccoon::Transport uses the in-tree raccoon_ring SHM library
# (one /dev/shm/raccoon_ring_<channel> file per channel). Restarts
# are safe in-place: rrb_writer_create re-initialises the existing
# header and subscribers detect the producer_seq reset and resync.
#
# We deliberately do NOT add a /dev/shm wipe in ExecStartPre — the
# previous version of this unit did, and that was directly responsible
# for botui losing all sensor channels after the first reader-watchdog
# restart cycle. Unlinking the ring file kills every subscriber that
# has the file mmap'd (their mmap becomes an unreachable anonymous
# region), and the new reader's freshly-created file with the same
# path is a different inode the old subscriber will never see.

ExecStart=/home/pi/stm32_data_reader/stm32_data_reader

Restart=always
RestartSec=5

NoNewPrivileges=true
# All sandboxing options that build a private mount namespace MUST stay off.
# ProtectSystem=, ProtectHome=, and PrivateTmp= each clone /proc/self/ns/mnt
# for the service. systemd then makes /dev/shm an MS_SLAVE bind underneath
# that clone, so any /dev/shm/raccoon_ring_* file the reader creates is
# invisible to every other process on the host (libstp probe sees an empty
# /dev/shm and times out waiting for IMU heading / BEMF / battery). Verified
# on 2026-06-02: dropping ProtectSystem+ProtectHome turned a 100 % probe-fail
# Pi green within 0.1 s. Leave them off.
PrivateTmp=false

[Install]
WantedBy=multi-user.target
