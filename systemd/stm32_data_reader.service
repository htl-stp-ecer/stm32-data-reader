[Unit]
Description=STM32 Data Reader with LCM
Requires=lcm-loopback-multicast.service
After=lcm-loopback-multicast.service
# Be the canonical source-of-truth for /tmp/iceoryx2: every other iox2
# user on this host (raccoon.service, project vision daemons, ad-hoc
# main.py runs) must come up AFTER us so they inherit the clean state
# we establish in ExecStartPre below. Without this, an already-running
# peer can hold dirty /tmp/iceoryx2 entries open while we wipe them,
# producing OpenIsMarkedForDestruction races they cannot recover from.
Before=raccoon.service

[Service]
User=pi
Group=pi

WorkingDirectory=/home/pi/stm32_data_reader

# Nuke iceoryx2 state under the reader's own uid before the binary
# starts. The reader is the authoritative iox2 owner on this host —
# its restart resets the bus for every other iox2 user.
#
# Why this is safe to run on every (re)start:
#   * Reader is `Before=raccoon.service`; on boot nothing else has
#     touched /tmp/iceoryx2 yet, so the rm is a no-op or just clears
#     leftover state from a previous boot.
#   * On a restart-while-mission: peers see the fresh state on their
#     next open_or_create, and our 5 s retry budget + the janitor's
#     dead-node sweep cover the transition.
#   * Running as User=pi means the entries it creates are pi-owned
#     (drwxr-xr-x pi:pi), so non-root peers can read them. That's
#     the documented failure mode for "iox2 SHM owned by another
#     user" — running the cleanup under pi guarantees we never
#     re-introduce it.
#
# `-` prefix on the second line tells systemd to ignore a non-zero
# exit (rm with no matches errors on bash but the dash makes systemd
# not propagate that).
# `-` prefix tells systemd to ignore a non-zero exit (rm of an
# already-missing path is a no-op anyway, and root-owned leftovers
# from an accidental sudo would fail this step — we'd rather log a
# warning and try the binary than refuse to start the reader).
ExecStartPre=-/bin/rm -rf /tmp/iceoryx2
ExecStartPre=-/bin/sh -c 'rm -f /dev/shm/iox2_*'
ExecStart=/home/pi/stm32_data_reader/stm32_data_reader

Restart=always
RestartSec=5

NoNewPrivileges=true
# PrivateTmp MUST be off: iceoryx2 stores its service-discovery registry
# under /tmp/iceoryx2/, and a private /tmp namespace cuts this service
# off from every other process that subscribes to the same channels
# (raccoon-lib Python, the UI bridge, etc.).
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target