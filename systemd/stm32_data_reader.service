[Unit]
Description=STM32 Data Reader with LCM
Requires=lcm-loopback-multicast.service
After=lcm-loopback-multicast.service
# Be the canonical source-of-truth for /tmp/iceoryx2: every other iox2
# user on this host (raccoon.service, project vision daemons, ad-hoc
# main.py runs) must come up AFTER us so they inherit the clean state
# we establish in ExecStartPre below. Without this, an already-running
# peer can hold dirty /tmp/iceoryx2 entries open while we wipe them,
# producing OpenIsMarkedForDestruction races they cannot recover from.
Before=raccoon.service

[Service]
User=pi
Group=pi

WorkingDirectory=/home/pi/stm32_data_reader

# Nuke iceoryx2 state under the reader's own uid — but ONLY on the
# first start after a reboot. Critical subtlety the naive form got
# wrong: nuking on every (re)start of the reader corrupts every
# already-running peer's bus handles (their in-memory iox2 ports
# stay bound to /tmp/iceoryx2/services/* entries we just deleted),
# producing exactly the OpenIsMarkedForDestruction churn we set out
# to eliminate.
#
# Strategy: a tmpfs flag file. /run is tmpfs (cleared on every
# reboot), so the flag is absent at boot → first start nukes and
# claims the bus, sets the flag. Subsequent restarts (Restart=always
# kicking in after a crash, manual `systemctl restart`, the
# raccoon.service install flow restarting us) see the flag and
# leave state alone — peers keep working.
#
# Running as User=pi means everything iox2 creates is pi-owned, so
# non-root peers can read it (defends against the "iox2 SHM owned
# by another user" failure mode the pre-flight check in raccoon-lib
# detects).
#
# `-` prefix on the cleanup line tells systemd to ignore non-zero
# exits — we'd rather log a warning and start the reader than refuse.
ExecStartPre=/bin/mkdir -p /run/raccoon
ExecStartPre=-/bin/sh -c 'if [ ! -e /run/raccoon/iox2-claimed ]; then rm -rf /tmp/iceoryx2; rm -f /dev/shm/iox2_*; touch /run/raccoon/iox2-claimed; echo "iox2 bus claimed (first start after boot)"; else echo "iox2 bus already claimed this boot — preserving peer state"; fi'
ExecStart=/home/pi/stm32_data_reader/stm32_data_reader

Restart=always
RestartSec=5

NoNewPrivileges=true
# PrivateTmp MUST be off: iceoryx2 stores its service-discovery registry
# under /tmp/iceoryx2/, and a private /tmp namespace cuts this service
# off from every other process that subscribes to the same channels
# (raccoon-lib Python, the UI bridge, etc.).
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target