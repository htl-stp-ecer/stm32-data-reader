[Unit]
Description=STM32 Data Reader (raccoon_ring backend)
Requires=lcm-loopback-multicast.service
After=lcm-loopback-multicast.service

[Service]
User=pi
Group=pi

WorkingDirectory=/home/pi/stm32_data_reader

# raccoon::Transport now uses the in-tree raccoon_ring SHM library
# (one /dev/shm/raccoon_ring_<channel> file per channel) instead of
# iceoryx2. There is nothing stateful left on /tmp/iceoryx2 to nuke or
# arbitrate ownership of — when reader restarts it simply re-mmaps the
# same files in-place. Subscribers see the producer sequence counter
# reset and naturally resync. So no ExecStartPre dance, no iox2-claimed
# flag, no need for the boot-order coordination we used to do here.

# Stale rings from a prior reader process don't poison anything (raccoon_ring
# re-initialises in place on writer_create), but they DO leave kbytes of
# /dev/shm around. Wipe on each boot only — restarts of a running peer keep
# their files intact.
RuntimeDirectory=raccoon
RuntimeDirectoryPreserve=restart
ExecStartPre=-/bin/sh -c 'if [ ! -e /run/raccoon/rings-claimed ]; then rm -f /dev/shm/raccoon_ring_*; touch /run/raccoon/rings-claimed; echo "ring buffers wiped (first start after boot)"; fi'

ExecStart=/home/pi/stm32_data_reader/stm32_data_reader

Restart=always
RestartSec=5

NoNewPrivileges=true
# PrivateTmp must stay off so subscribers see our /dev/shm rings. (raccoon_ring
# lives in /dev/shm which is unaffected by PrivateTmp, but the lcm-loopback
# multicast plumbing under /tmp can be — keeping the old setting for now.)
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
