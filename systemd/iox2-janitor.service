[Unit]
Description=iceoryx2 dead-node janitor — keeps /tmp/iceoryx2 clean
Documentation=https://github.com/htl-stp-ecer/raccoon-transport
# iceoryx2 is daemon-less by design (no RouDi). When a process dies
# without running its destructors it leaves orphan node descriptors
# under /tmp/iceoryx2/ that can wedge the next NodeBuilder::create()
# with OpenIsMarkedForDestruction. This service runs the iox2
# try_cleanup_dead_nodes() API on a 2-second tick so the orphans are
# reaped before any consumer sees them.
#
# Boot order:
#   stm32_data_reader.service nukes /tmp/iceoryx2 in its ExecStartPre and
#   then claims the bus as the canonical owner. The janitor must run
#   AFTER it so we don't sweep entries the reader is mid-creating, and
#   so the janitor's first sweep sees the clean state the reader just
#   established. From that point on we just keep state tidy for the
#   lifetime of the bus.
After=network.target stm32_data_reader.service

[Service]
Type=simple
# Same uid as every other iox2 user on the host. Running as root
# would create /tmp/iceoryx2 entries that pi-user processes can't
# read (drwxr-x--- root:root) and is the documented reason for the
# "iceoryx2 SHM owned by another user" pre-flight error.
User=pi
Group=pi

# The binary is shipped next to stm32_data_reader on /home/pi.
# Argument is the sweep period in milliseconds.
#
# 30 s is the tuned default after profiling on a Pi 3B: each
# try_cleanup_dead_nodes call walks /tmp/iceoryx2/services/* and
# does ~1k syscalls (getdents+open+stat+close), costing about
# 0.5 s of CPU per sweep when a stuck node is present. A 2 s
# period turned that into 25 % steady-state CPU — unacceptable
# for "transport nebenbei". 30 s drops it to ~1.5 % and still
# reaps any post-crash orphan well before the next user run
# (the *initial* sweep on systemd start covers boot-time state,
# subsequent sweeps just catch later crashes).
ExecStart=/home/pi/stm32_data_reader/iox2_janitor 30000

# stderr-only logging (matches the binary). systemd-journal captures
# every reaped-node line so the operator can correlate self-heal
# events with crashes.
StandardError=journal

# Restart on crash — but cap the burst so a packaging mistake
# doesn't loop forever.
Restart=always
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=5

# We need to read+write /tmp/iceoryx2/ and the pi-owned files
# inside it. ProtectSystem=full keeps /home read-only-ish but /tmp
# stays writable, which is what we need.
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
